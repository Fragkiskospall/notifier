# Τοπικά, τα ευαίσθητα στοιχεία ζουν στο Keychain (Mac) ή στο Credential Manager (Windows):
#   python -m uniwa_notifier secrets import      (από αυτό το αρχείο, μία φορά)
#   python -m uniwa_notifier secrets set KEY     (αλλαγή ενός)
# Στο cloud είναι GitHub Secrets με τα ίδια ονόματα.
# Οι υπόλοιπες ρυθμίσεις είναι στο config.toml.

ECLASS_USERNAME=
ECLASS_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
NTFY_TOPIC=
# Προαιρετικό heartbeat, π.χ. https://hc-ping.com/<uuid>
HEALTHCHECK_URL=
